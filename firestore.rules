rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isSuperAdmin() {
      let userData = getUserData();
      return userData != null && userData.isSuperAdmin == true;
    }

    function isClassAdmin(classId) {
      let userData = getUserData();
      return userData != null && userData.classId == classId && userData.role == 'admin';
    }

    function sameClass(classId) {
      let userData = getUserData();
      return userData != null && userData.classId == classId;
    }

    function isClassMember(classId) {
      return isSuperAdmin() || sameClass(classId);
    }

    // Users — portal enroll upserts via Admin SDK (bypasses rules)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Classes — portal auto-create via Admin SDK
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isSuperAdmin();
      allow delete: if isAuthenticated() && isSuperAdmin();
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        isClassAdmin(classId) ||
        (
          sameClass(classId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['adminCodeUses', 'admins'])
        )
      );
    }

    // Subjects — portal sync via Admin SDK; CRs manage extras
    match /subjects/{subjectId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData() != null && getUserData().classId == resource.data.classId)
      );
      allow create, update: if isAuthenticated() && isClassAdmin(request.resource.data.classId);
      allow delete: if false;
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && isClassMember(resource.data.classId);
      allow create: if isAuthenticated() && isClassMember(request.resource.data.classId);
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.uid == resource.data.createdBy ||
        isClassAdmin(resource.data.classId) ||
        (
          sameClass(resource.data.classId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedBy'])
        )
      );
      allow delete: if false;
    }

    // Posts — require classId for class-scoped access (matches composite indexes)
    match /posts/{postId} {
      allow read: if isAuthenticated() && isClassMember(resource.data.classId);
      allow create: if isAuthenticated() &&
        request.resource.data.classId is string &&
        isClassMember(request.resource.data.classId);
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        sameClass(resource.data.classId)
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.createdBy ||
        isClassAdmin(resource.data.classId) ||
        isSuperAdmin()
      );
    }

    // Events
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['goingCount']) ||
        (request.auth.uid == resource.data.createdBy && request.resource.data.status == 'pending') ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.createdBy ||
        isSuperAdmin()
      );
    }

    match /event_participations/{participationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // Retired with Super Admin class-transfer UI
    match /class_change_requests/{requestId} {
      allow read, create, update, delete: if false;
    }

    // In-app + CR section broadcast (classId on broadcast docs)
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.uid == resource.data.userId
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.uid == request.resource.data.userId ||
        (
          request.resource.data.classId is string &&
          isClassAdmin(request.resource.data.classId)
        )
      );
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /institutes/{instituteId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
